# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Environment & Port (Default: 3000)
NODE_ENV=production
PORT=3000

# Storage directory on the Ubuntu VPS filesystem (real video storage)
# Default for VPS production: /var/lib/xorvilabox/storage
# Default for dev/container: ./data/storage
STORAGE_PATH=/var/lib/xorvilabox/storage

# SQLite database file path or URL (uses @libsql/client)
DATABASE_URL=file:./data/xorvilabox.db

# Public Base URL for generating Raw URLs
PUBLIC_BASE_URL=

# Session / Authentication signing secret
SESSION_SECRET=change-this-secret-to-a-secure-random-string

# Initial Admin default password
ADMIN_DEFAULT_PASSWORD=admin123

# File limits in bytes
MAX_UPLOAD_SIZE=5368709120
MAX_IMPORT_SIZE=10737418240
MAX_ZIP_SIZE=10737418240

